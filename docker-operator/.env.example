# This file is for running `docker compose` from THIS directory
# (docker-operator/). The default is to run it from the REPO ROOT instead --
# then use ../.env.example and put .env at the repo root. The variables are the
# same; the repo-root copy is the canonical one.
#
# Copy to `.env` (gitignored) here and fill in. docker compose reads it
# automatically. NOTE: plain KEY=VALUE lines — docker compose does NOT source
# this like a shell script, so do NOT prefix lines with `export`.
#
# config.yaml / credentials.yaml / dependaproxy.yaml (git-proxy + DependaProxy
# config, incl. the GitHub PAT) live at the repo root and this stack mounts them
# via ../ -- fill them in per the root README's Quickstart if you have not
# already. This file only covers docker-operator's OWN variables plus the ones
# the shared services still need.

# Ollama Cloud auth — :cloud models are proxied to ollama.com by the local
# daemon, which authenticates the DEVICE with the SSH keypair in ./.ollama
# (id_ed25519 + config.json), NOT an API key. Two ways to set that up:
#   1. copy your existing .ollama/ folder (with the registered key) onto the
#      host next to docker-compose.yaml (the ollama service bind-mounts it); or
#   2. start fresh: `docker compose exec ollama ollama signin` once and approve
#      the URL it prints (the key is stored in ./.ollama and persists).
# (OLLAMA_API_KEY is only for DIRECT ollama.com API calls, which this stack
#  does not make — leave it unset.)

# The LLM backend a create request that names none falls back to: "ollama"
# or "anthropic". Each agent records its own choice (picked on the web UI's
# create form); this is only the default. An "anthropic" agent uses the
# shared Anthropic credential (web UI "Anthropic account" panel, or
# PUT /api/anthropic/auth) and ignores OLLAMA_URL and the models below.
DEFAULT_AGENT_BACKEND=ollama

# The create form's default for an "ollama" agent's default/"opus" tier
# (editable per agent). Only used by "ollama" agents.
#   - :cloud suffix  -> cloud-hosted on ollama.com (needs .ollama key /
#     `ollama signin`, see above), e.g.
#     glm-5.3:cloud, kimi-k2.7-code:cloud, qwen3.5:397b:cloud
#   - no suffix      -> a local model you have pulled
#     (`docker compose exec ollama ollama pull <model>`), e.g. qwen3:8b
# Defaults to glm-5.3:cloud if unset.
OLLAMA_MODEL=glm-5.3:cloud

# The create form's default for an "ollama" agent's "sonnet"/"haiku" tiers
# (ANTHROPIC_DEFAULT_SONNET_MODEL and ANTHROPIC_DEFAULT_HAIKU_MODEL both map
# here -- leaving either tier unmapped is what would let Task/general model
# selection fall through to the real Anthropic API instead of Ollama). Same
# :cloud rules as OLLAMA_MODEL above. Defaults to glm-5.3-flash:cloud if unset.
OLLAMA_FAST_MODEL=glm-5.3-flash:cloud

# Ollama context window (passed to the daemon).
OLLAMA_NUM_CTX=131072

# Agent Bearer presented to git-proxy. MUST match auth.tokens in config.yaml
# (default config maps "agent-token-1" -> "claude-code-agent"). The proxy consumes
# this for auth only; it is never forwarded to GitHub. This is NOT the GitHub PAT.
# Shared by every agent this operator creates -- see docker-operator/README.md's
# "V1 is a local-only tool" note.
AGENT_TOKEN=agent-token-1

# OPTIONAL but strongly recommended: a static Bearer that gates the operator's
# own REST API and terminal WebSockets (this is NOT AGENT_TOKEN and has nothing
# to do with git-proxy). Leave it blank and the API is open to anything that can
# reach 127.0.0.1:${LISTEN_PORT}; the operator logs a startup warning in that
# case. Set it to a long random value:  openssl rand -hex 32
#   - browser:  open  http://127.0.0.1:8000/?token=<value>  once; the UI stores
#     it in localStorage and strips it from the URL.
#   - curl:     -H "Authorization: Bearer <value>"
OPERATOR_API_TOKEN=

# OPTIONAL. The owner/repo.git a create request that names no per-agent repo
# falls back to -- templated into the agent as GITHUB_REPO. Nothing auto-clones
# it; whoever drives the agent runs the first `git clone` in the terminal,
# through the git-proxy rewrite. Leave it blank and every agent boots as a bare
# Claude terminal; each agent can still be pinned to its own repo on the web
# create form / the POST /api/agents "repo" field. When set (here or per agent)
# it must look like owner/repo or owner/repo.git and match a repo pattern in
# credentials.yaml for pushes/PRs to authenticate.
GITHUB_REPO=psenna/ai-sandbox.git

# Hard cap on concurrently existing agents (internal/config's MaxAgents).
# Enforced atomically before any Docker resource is created -- the (N+1)th
# concurrent create gets a clean 409, not a queued request.
MAX_AGENTS=5

# Agent container image (docker-operator/agent/Dockerfile, NOT the root
# Dockerfile -- adds tmux, trims skills). Published to GHCR by
# .github/workflows/docker-operator-agent-image.yml on every
# docker-operator/agent/** change to main, tagged with a UTC date-time plus
# :latest; the operator pulls it on first use. To pin a build for
# reproducibility, set a date-time tag here (e.g. :20260909-143000). A local
# `make agent-image` builds and tags this same :latest reference, so it
# transparently shadows the published image for local development.
AGENT_IMAGE=ghcr.io/psenna/ai-sandbox-agent:latest

# Agent-image tag discovery. The operator polls the registry for the
# :YYYYMMDD-HHMMSS tags of AGENT_IMAGE and shows them in the web UI (sidebar
# panel + a per-agent dropdown on the create form).
#   AGENT_IMAGE_REFRESH_INTERVAL -- how often to poll (Go duration; default
#     1h; the operator floors it at 1m).
#   AGENT_IMAGE_REGISTRY_URL     -- override the registry root; empty derives
#     it from AGENT_IMAGE's domain (https://<domain>).
#   AGENT_IMAGE_REGISTRY_TOKEN   -- Bearer forwarded to the registry; only
#     needed for a private agent-image repository (GHCR public repos need none).
AGENT_IMAGE_REFRESH_INTERVAL=1h
AGENT_IMAGE_REGISTRY_URL=
AGENT_IMAGE_REGISTRY_TOKEN=

# OCI runtime for each agent's private DinD sidecar. sysbox-runc is what
# makes an unprivileged inner daemon possible -- see
# ../setup-ubuntu-host.sh. Without it installed, every create fails at the
# DinD-sidecar step (see docker-operator/README.md's quickstart step 4).
DOCKER_RUNTIME=sysbox-runc

# Host port the API/WebSocket/web UI are published on (127.0.0.1 only, see
# docker-compose.yaml). Change if 8000 is already taken on your host.
LISTEN_PORT=8000

# Centralized per-agent file store (issue #122). The store is configured in
# docker-compose.yaml, not here: FILESTORE_DIR (the path the operator sees the
# shared store at) and FILESTORE_VOLUME (the Docker volume name the daemon
# resolves each agent's per-agent subpath mount against) are two names for the
# same storage and must stay in lockstep with the `- filestore:...` mount, so
# they live next to that mount. FILESTORE_MAX_UPLOAD_BYTES caps a single upload
# (default 100 MiB). Set FILESTORE_DIR to an empty value in docker-compose.yaml
# to disable the whole feature (no file API, no /workspace/store or
# /workspace/shared mount).

# DependaProxy token — UNUSED in this stack: auth is disabled (auth.token: "" in
# dependaproxy.yaml) because Go's module client refuses credentials over
# plaintext HTTP and the proxy is on isolated internal networks. If you
# re-enable auth, set this to the same value as auth.token in dependaproxy.yaml
# (npm sends it as a Bearer header; pip and Go as HTTP Basic auth, password ==
# token). Never commit a real value.
DEPENDAPROXY_TOKEN=change-me
