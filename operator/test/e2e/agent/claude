#!/bin/bash
# Fake `claude` CLI for the e2e test-agent image. Parses `-p <prompt>`
# (exactly how RenderPod's agentCommand invokes the real CLI: `claude -p
# "$(cat task.md)"`) and interprets the prompt as one SCRIPT: directive per
# line, executed in order. This lets e2e specs script pod behaviour (write
# files, require env/mounts, hit HTTP endpoints, sleep, exit with a chosen
# code) without needing a real agent or model.
#
# Directives (one per line):
#   SCRIPT:echo <text>                      print <text> to stdout
#   SCRIPT:log <text>                       print <text> to stderr
#   SCRIPT:sleep <seconds>                  sleep (makes phase Running observable)
#   SCRIPT:write <relpath> <text>           write <text> under $WORKDIR/<relpath>          (exit 14 on failure)
#   SCRIPT:require-env <NAME>               fail unless env var NAME is non-empty          (exit 10)
#   SCRIPT:require-file <path>              fail unless <path> is readable                (exit 11)
#   SCRIPT:http-get <url>                   `curl -fsS --max-time 5 <url>` must succeed    (exit 12)
#   SCRIPT:http-expect-fail <url>           same GET must FAIL                             (exit 13)
#   SCRIPT:exit <code>                      exit immediately with <code>
#   SCRIPT:sandbox-wait <json>              POST $SIDECAR/v1/wait, must return 2xx         (exit 30)
#   SCRIPT:sandbox-wait-expect-fail <json>  same POST must return 4xx                      (exit 31)
#   SCRIPT:sandbox-done <outcome> <message> POST $SIDECAR/v1/done                          (exit 32)
#   SCRIPT:sandbox-progress <message>       POST $SIDECAR/v1/progress                      (exit 33)
#   SCRIPT:sandbox-status                   GET  $SIDECAR/v1/status, echo to stdout        (exit 34)
#   SCRIPT:sandbox-expect-loopback-only     GET on the pod's own non-loopback IP must FAIL
#                                            while GET on localhost succeeds               (exit 35)
#   SCRIPT:sandbox-services-apply <json>  POST $SIDECAR/v1/services, must 2xx   (exit 40)
#   SCRIPT:sandbox-exec <runtime> <cmd...> POST $SIDECAR/v1/exec; expect 2xx + exitCode 0
#                                          (exit 41 on API non-2xx or exitCode!=0)
#   SCRIPT:sandbox-exec-expect-fail <runtime> <cmd...> same exec; expect 2xx + exitCode>0
#                                          (exit 42 if API non-2xx OR exitCode<=0;
#                                          exitCode<0 is a transport failure -- the
#                                          command never ran -- not an expected fail)
#   SCRIPT:sandbox-exec-wait-ready <runtime>  poll /v1/exec with `true` until the
#                                          runtime pod is running+exec-able (exitCode 0);
#                                          a real readiness gate replacing a fixed sleep
#                                          before sandbox-exec(-expect-fail)        (exit 43)
#   SCRIPT:require-no-file <path>           inverse of require-file: fail if readable      (exit 36)
#   SCRIPT:write-tree <relpath> <bytes>     write <bytes> of /dev/urandom under
#                                            $WORKDIR/<relpath>                             (exit 37 on failure)
#   SCRIPT:write-home <relpath> <text>      write <text> under $CLAUDE_CONFIG_DIR/<relpath>
#                                            (the agent home, snapshotted as agent-home.tar.zst
#                                            on freeze -- the context-resumption proof)      (exit 38)
#   SCRIPT:append-home <relpath> <text>     append <text> to $CLAUDE_CONFIG_DIR/<relpath>;
#                                            proves the restored home is writable by uid 1000,
#                                            not read-only/root-owned                          (exit 38)
#   SCRIPT:require-home-file <relpath> <substring>
#                                            fail unless $CLAUDE_CONFIG_DIR/<relpath> is
#                                            readable AND contains <substring> (post-wake
#                                            assertion executed inside the woken pod)         (exit 38)
#   SCRIPT:tree-sha256 <root> <outfile>     deterministic digest over <root>: sorted paths,
#                                            per-file mode+size+sha256, symlink targets;
#                                            EXCLUDING .sandbox/, directory modes and mtimes
#                                            (all legitimately differ across a restore)       (exit 39)
#   SCRIPT:require-tree-sha256 <root> <file>
#                                            recompute the digest of <root> and compare
#                                            against <file>; non-zero exit on mismatch        (exit 39)
#   SCRIPT:if-file <path> <directive>        run <directive> (a full SCRIPT: line, the
#                                           remainder of this line) only when <path> is
#                                           readable; otherwise skip it. Lets a single
#                                           immutable prompt self-branch on the wake marker
#                                           (.sandbox/last-wake.json, written by the restore
#                                           init container only on a wake) so run 1 (ends in
#                                           sandbox-wait) and the woken run (asserts the
#                                           restoration) can be one task.prompt #29  (exit NN
#                                           propagates from the inner directive)
#   SCRIPT:unless-file <path> <directive>    the inverse of if-file: run <directive> only when
#                                           <path> is NOT readable                         (exit NN
#                                           propagates from the inner directive)
# An empty prompt, or a prompt with no directives, exits 0. An unrecognised
# `SCRIPT:` line exits 20.

WORKDIR="${PWD:-/workspace}"
SIDECAR="${SANDBOX_SIDECAR_URL:-http://localhost:9099}"
prompt=""

while [ $# -gt 0 ]; do
	case "$1" in
	-p)
		shift
		prompt="${1:-}"
		shift || true
		;;
	*)
		shift
		;;
	esac
done

if [ -z "$prompt" ]; then
	exit 0
fi

dispatch() { # dispatch <line> -- run one SCRIPT: directive (exit N propagates)
	local line="$1"
	case "$line" in
	"SCRIPT:echo "*)
		printf '%s\n' "${line#SCRIPT:echo }"
		;;
	"SCRIPT:log "*)
		printf '%s\n' "${line#SCRIPT:log }" >&2
		;;
	"SCRIPT:sleep "*)
		sleep "${line#SCRIPT:sleep }"
		;;
	"SCRIPT:write "*)
		rest="${line#SCRIPT:write }"
		relpath="${rest%% *}"
		text="${rest#* }"
		target="$WORKDIR/$relpath"
		mkdir -p "$(dirname "$target")" || exit 14
		printf '%s\n' "$text" >"$target" || exit 14
		;;
	"SCRIPT:require-env "*)
		name="${line#SCRIPT:require-env }"
		val="${!name:-}"
		[ -n "$val" ] || exit 10
		;;
	"SCRIPT:require-file "*)
		path="${line#SCRIPT:require-file }"
		[ -r "$path" ] || exit 11
		;;
	"SCRIPT:http-get "*)
		url="${line#SCRIPT:http-get }"
		curl -fsS --max-time 5 "$url" >/dev/null || exit 12
		;;
	"SCRIPT:http-expect-fail "*)
		url="${line#SCRIPT:http-expect-fail }"
		if curl -fsS --max-time 5 "$url" >/dev/null 2>&1; then
			exit 13
		fi
		;;
	"SCRIPT:sandbox-wait "*)
		payload="${line#SCRIPT:sandbox-wait }"
		code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 5 -X POST "$SIDECAR/v1/wait" -H 'Content-Type: application/json' -d "$payload")"
		case "$code" in
		2??) ;;
		*)
			echo "claude: sandbox-wait got HTTP $code, want 2xx" >&2
			exit 30
			;;
		esac
		;;
	"SCRIPT:sandbox-wait-expect-fail "*)
		payload="${line#SCRIPT:sandbox-wait-expect-fail }"
		code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 5 -X POST "$SIDECAR/v1/wait" -H 'Content-Type: application/json' -d "$payload")"
		case "$code" in
		4??) ;;
		*)
			echo "claude: sandbox-wait-expect-fail got HTTP $code, want 4xx" >&2
			exit 31
			;;
		esac
		;;
	"SCRIPT:sandbox-done "*)
		rest="${line#SCRIPT:sandbox-done }"
		outcome="${rest%% *}"
		message="${rest#* }"
		payload="$(printf '{"outcome":"%s","message":"%s"}' "$outcome" "$message")"
		code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 5 -X POST "$SIDECAR/v1/done" -H 'Content-Type: application/json' -d "$payload")"
		case "$code" in
		2??) ;;
		*)
			echo "claude: sandbox-done got HTTP $code, want 2xx" >&2
			exit 32
			;;
		esac
		;;
	"SCRIPT:sandbox-progress "*)
		message="${line#SCRIPT:sandbox-progress }"
		payload="$(printf '{"message":"%s"}' "$message")"
		code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 5 -X POST "$SIDECAR/v1/progress" -H 'Content-Type: application/json' -d "$payload")"
		case "$code" in
		2??) ;;
		*)
			echo "claude: sandbox-progress got HTTP $code, want 2xx" >&2
			exit 33
			;;
		esac
		;;
	"SCRIPT:sandbox-status")
		curl -fsS --max-time 5 "$SIDECAR/v1/status" || exit 34
		;;
	"SCRIPT:sandbox-expect-loopback-only")
		podip="$(hostname -i 2>/dev/null || true)"
		if [ -z "$podip" ]; then
			podip="$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n1)"
		fi
		if [ -n "$podip" ] && curl -fsS --max-time 3 "http://$podip:9099/healthz" >/dev/null 2>&1; then
			echo "claude: sandbox control API unexpectedly reachable via pod IP $podip" >&2
			exit 35
		fi
		curl -fsS --max-time 5 "$SIDECAR/healthz" >/dev/null 2>&1 || {
			echo "claude: sandbox control API unreachable via loopback" >&2
			exit 35
		}
		;;
	"SCRIPT:sandbox-services-apply "*)
		payload="${line#SCRIPT:sandbox-services-apply }"
		code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 10 -X POST "$SIDECAR/v1/services" -H 'Content-Type: application/json' -d "$payload")"
		case "$code" in
		2??) ;;
		*)
			echo "claude: sandbox-services-apply got HTTP $code, want 2xx" >&2
			exit 40
			;;
		esac
		;;
	"SCRIPT:sandbox-exec "*)
		rest="${line#SCRIPT:sandbox-exec }"
		runtime="${rest%% *}"
		cmdline="${rest#* }"
		cmdjson="$(printf '%s' "$cmdline" | awk '{for(i=1;i<=NF;i++){printf "\"%s\"%s",$i,(i<NF?",":"")}}')"
		payload="$(printf '{"runtime":"%s","command":[%s]}' "$runtime" "$cmdjson")"
		resp="$(curl -sS --max-time 30 -X POST "$SIDECAR/v1/exec" -H 'Content-Type: application/json' -d "$payload")"
		rc=$?
		if [ "$rc" -ne 0 ]; then
			echo "claude: sandbox-exec curl failed (rc=$rc)" >&2
			exit 41
		fi
		ec="$(printf '%s' "$resp" | sed -n 's/.*"exitCode":\(-\?[0-9]\+\).*/\1/p')"
		[ -n "$ec" ] || ec=-1
		if [ "$ec" -ne 0 ]; then
			echo "claude: sandbox-exec exitCode=$ec (want 0): $resp" >&2
			exit 41
		fi
		;;
	"SCRIPT:sandbox-exec-expect-fail "*)
		rest="${line#SCRIPT:sandbox-exec-expect-fail }"
		runtime="${rest%% *}"
		cmdline="${rest#* }"
		cmdjson="$(printf '%s' "$cmdline" | awk '{for(i=1;i<=NF;i++){printf "\"%s\"%s",$i,(i<NF?",":"")}}')"
		payload="$(printf '{"runtime":"%s","command":[%s]}' "$runtime" "$cmdjson")"
		resp="$(curl -sS --max-time 30 -X POST "$SIDECAR/v1/exec" -H 'Content-Type: application/json' -d "$payload")"
		rc=$?
		if [ "$rc" -ne 0 ]; then
			echo "claude: sandbox-exec-expect-fail curl failed (rc=$rc)" >&2
			exit 42
		fi
		ec="$(printf '%s' "$resp" | sed -n 's/.*"exitCode":\(-\?[0-9]\+\).*/\1/p')"
		[ -n "$ec" ] || ec=-1
		# exitCode > 0: the command ran and failed (the expected case -- e.g.
		# egress blocked -> wget exits non-zero). exitCode == 0: it succeeded.
		# exitCode < 0: a transport/protocol failure (the runtime pod was not
		# found/ready), so the command never ran -- NOT an expected failure.
		# Reject both (exit 42) so the spec fails loud rather than false-passing
		# on a not-yet-scheduled pod.
		if [ "$ec" -lt 1 ]; then
			echo "claude: sandbox-exec-expect-fail exitCode=$ec (want >0: command ran+failed; <=0 is success or transport failure): $resp" >&2
			exit 42
		fi
		;;
	"SCRIPT:sandbox-exec-wait-ready "*)
		# Gate on real readiness before a later sandbox-exec(-expect-fail):
		# poll /v1/exec with `true` until the runtime pod's container is running
		# AND the exec path works (exitCode 0). A not-yet-scheduled/running pod
		# makes /v1/exec return exitCode<0 (transport failure), which the exec
		# directives treat as a LOUD failure -- so a fixed `sleep 30` was the
		# wrong gate (a slow scheduler/image-pull tripped it). This mirrors the
		# control-plane isolation spec's PodRunning wait, but from inside the
		# agent script so the end-to-end apply+exec flow is preserved. exit 43
		# if the pod never becomes exec-able within the budget.
		runtime="${line#SCRIPT:sandbox-exec-wait-ready }"
		ec=-1
		for _ in $(seq 1 60); do   # up to ~120s at a 2s backoff
			resp="$(curl -sS --max-time 10 -X POST "$SIDECAR/v1/exec" \
				-H 'Content-Type: application/json' \
				-d "{\"runtime\":\"$runtime\",\"command\":[\"true\"]}")"
			rc=$?
			if [ "$rc" -eq 0 ]; then
				ec="$(printf '%s' "$resp" | sed -n 's/.*"exitCode":\(-\?[0-9]\+\).*/\1/p')"
				[ -n "$ec" ] || ec=-1
				[ "$ec" -eq 0 ] && break
			else
				ec=-1
			fi
			sleep 2
		done
		if [ "$ec" -ne 0 ]; then
			echo "claude: sandbox-exec-wait-ready runtime $runtime never became exec-able (last exitCode=$ec): $resp" >&2
			exit 43
		fi
		;;
	"SCRIPT:require-no-file "*)
		path="${line#SCRIPT:require-no-file }"
		if [ -r "$path" ]; then
			exit 36
		fi
		;;
	"SCRIPT:write-tree "*)
		rest="${line#SCRIPT:write-tree }"
		relpath="${rest%% *}"
		nbytes="${rest#* }"
		target="$WORKDIR/$relpath"
		mkdir -p "$(dirname "$target")" || exit 37
		head -c "$nbytes" /dev/urandom >"$target" || exit 37
		;;
	"SCRIPT:write-home "*)
		rest="${line#SCRIPT:write-home }"
		relpath="${rest%% *}"
		text="${rest#* }"
		target="${CLAUDE_CONFIG_DIR:-/home/node/.claude-sandbox}/$relpath"
		mkdir -p "$(dirname "$target")" || exit 38
		printf '%s\n' "$text" >"$target" || exit 38
		;;
	"SCRIPT:append-home "*)
		rest="${line#SCRIPT:append-home }"
		relpath="${rest%% *}"
		text="${rest#* }"
		target="${CLAUDE_CONFIG_DIR:-/home/node/.claude-sandbox}/$relpath"
		mkdir -p "$(dirname "$target")" || exit 38
		printf '%s\n' "$text" >>"$target" || exit 38
		;;
	"SCRIPT:require-home-file "*)
		rest="${line#SCRIPT:require-home-file }"
		relpath="${rest%% *}"
		substring="${rest#* }"
		target="${CLAUDE_CONFIG_DIR:-/home/node/.claude-sandbox}/$relpath"
		[ -r "$target" ] || exit 38
		if [ -n "$substring" ]; then
			grep -qF -- "$substring" "$target" || exit 38
		fi
		;;
	"SCRIPT:tree-sha256 "*)
		rest="${line#SCRIPT:tree-sha256 }"
		root="${rest%% *}"
		outfile="${rest#* }"
		# Deterministic digest over <root>: sorted paths, per-file
		# mode+size+sha256, symlink targets. Excludes .sandbox/ (its markers
		# are legitimately rewritten on every freeze/wake), directory modes
		# (normalised by ReadArchive) and mtimes (not restored).
		(
			cd "$root" || exit 39
			find . -path ./.sandbox -prune -o -print | sort | while IFS= read -r p; do
				if [ -L "$p" ]; then
					printf 'L %s -> %s\n' "$p" "$(readlink "$p")"
				elif [ -f "$p" ]; then
					printf 'F %s %s %s %s\n' "$p" "$(stat -c %a "$p")" "$(stat -c %s "$p")" "$(sha256sum "$p" | cut -d' ' -f1)"
				fi
			done
		) >"$outfile" || exit 39
		;;
	"SCRIPT:require-tree-sha256 "*)
		rest="${line#SCRIPT:require-tree-sha256 }"
		root="${rest%% *}"
		file="${rest#* }"
		tmp="$(mktemp)" || exit 39
		(
			cd "$root" || exit 39
			find . -path ./.sandbox -prune -o -print | sort | while IFS= read -r p; do
				if [ -L "$p" ]; then
					printf 'L %s -> %s\n' "$p" "$(readlink "$p")"
				elif [ -f "$p" ]; then
					printf 'F %s %s %s %s\n' "$p" "$(stat -c %a "$p")" "$(stat -c %s "$p")" "$(sha256sum "$p" | cut -d' ' -f1)"
				fi
			done
		) >"$tmp" || exit 39
		cmp -s "$tmp" "$file" || {
			echo "claude: tree-sha256 mismatch for $root vs $file" >&2
			rm -f "$tmp"
			exit 39
		}
		rm -f "$tmp"
		;;
	"SCRIPT:if-file "*)
		rest="${line#SCRIPT:if-file }"
		path="${rest%% *}"
		sub="${rest#* }"
		[ -r "$path" ] && dispatch "$sub"
		;;
	"SCRIPT:unless-file "*)
		rest="${line#SCRIPT:unless-file }"
		path="${rest%% *}"
		sub="${rest#* }"
		[ -r "$path" ] || dispatch "$sub"
		;;
	"SCRIPT:exit "*)
		exit "${line#SCRIPT:exit }"
		;;
	"SCRIPT:"*)
		echo "claude: unrecognised directive: $line" >&2
		exit 20
		;;
	"")
		;;
	*)
		# Plain, non-directive prompt text: ignored.
		;;
	esac
}

while IFS= read -r line || [ -n "$line" ]; do
	dispatch "$line"
done <<PROMPT
$prompt
PROMPT

exit 0
